{
  // Vite strips types with esbuild and never typechecks. This config exists for
  // the editor and for `tsc --noEmit`; it has no effect on `vite build`.
  "compilerOptions": {
    // Vite 8 targets modern browsers and downlevels nothing at runtime, so
    // there is no reason to typecheck against an older target.
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    // Automatic JSX runtime — matches @vitejs/plugin-react, and is why no file
    // needs `import React` just to render JSX.
    "jsx": "react-jsx",

    // vite/client declares the non-code imports this app relies on
    // (./logo.svg, ./App.css). vitest/globals declares test/expect, which
    // vite.config.js exposes via `test.globals: true`.
    "types": ["vite/client", "vitest/globals"],

    "strict": true,
    "noEmit": true,

    // Vite transpiles one file at a time with no cross-file type info, so
    // reject the constructs that require it.
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // The whole app is still .jsx. allowJs pulls it into the program so imports
    // resolve; checkJs stays off so nothing breaks until a file is renamed to
    // .tsx deliberately — migrate one file at a time.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "vite.config.js", "eslint.config.js"]
}
